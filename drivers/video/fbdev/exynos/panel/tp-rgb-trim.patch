diff --git a/drivers/video/fbdev/exynos/panel/s6e3ha9/s6e3ha9.c b/drivers/video/fbdev/exynos/panel/s6e3ha9/s6e3ha9.c
index dc96f67..544639b 100644
--- a/drivers/video/fbdev/exynos/panel/s6e3ha9/s6e3ha9.c
+++ b/drivers/video/fbdev/exynos/panel/s6e3ha9/s6e3ha9.c
@@ -940,6 +940,37 @@ static int generate_hbm_gamma(struct panel_info *panel_data,
 	return ret;
 }
 
+/*
+ * Add the user's per tone-point RGB trim (props.tp_rgb_trim, set through
+ * /sys/class/lcd/panel/tp_*) to the finished 0xCA gamma payload.
+ * Done on the final bytes so it covers normal and HBM brightness alike.
+ * +step on a colour = lower data voltage = more light of that colour.
+ */
+static void apply_tp_rgb_trim(struct panel_info *panel_data, u8 *dst)
+{
+	s32 tp[S6E3HA9_NR_TP][MAX_COLOR];
+	int v, c, active = 0;
+
+	BUILD_BUG_ON(S6E3HA9_NR_TP > PANEL_NR_TP_TRIM);
+
+	for (v = 0; v < S6E3HA9_NR_TP; v++)
+		for_each_color(c)
+			if (panel_data->props.tp_rgb_trim[v][c])
+				active = 1;
+	if (!active)
+		return;
+
+	gamma_ctoi(tp, dst, S6E3HA9_NR_TP);
+	for (v = 0; v < S6E3HA9_NR_TP; v++) {
+		/* VT/V0: 4 bit, V255: 10 bit, everything else: 8 bit */
+		s32 lim = (v == S6E3HA9_NR_TP - 1) ? 1023 : (v < 2) ? 15 : 255;
+
+		for_each_color(c)
+			tp[v][c] = clamp(tp[v][c] + panel_data->props.tp_rgb_trim[v][c], 0, lim);
+	}
+	gamma_itoc(dst, tp, S6E3HA9_NR_TP);
+}
+
