diff --git a/drivers/video/fbdev/exynos/panel/sysfs.c b/drivers/video/fbdev/exynos/panel/sysfs.c
index bea4869..5832727 100644
--- a/drivers/video/fbdev/exynos/panel/sysfs.c
+++ b/drivers/video/fbdev/exynos/panel/sysfs.c
@@ -3736,6 +3736,149 @@ store_err:
 }
 #endif
 
+/*
+ * Per tone-point (TP) RGB trim of the panel gamma register (S6E3HA9, 0xCA).
+ *
+ *   /sys/class/lcd/panel/tp_vt  tp_v0   tp_v1   tp_v7   tp_v11  tp_v23
+ *                        tp_v35 tp_v51  tp_v87  tp_v151 tp_v203 tp_v255
+ *     cat            -> "R G B"  (signed raw gamma steps, default "0 0 0")
+ *     echo "R G B" > -> applied at once, at every brightness level
+ *   /sys/class/lcd/panel/tp_table   (read)  all trims in one table
+ *   /sys/class/lcd/panel/tp_reset   (write 1) all trims back to 0
+ *
+ * +step = more light of that colour at that gray point.
+ */
+static const char * const tp_trim_name[PANEL_NR_TP_TRIM] = {
+	"vt", "v0", "v1", "v7", "v11", "v23",
+	"v35", "v51", "v87", "v151", "v203", "v255",
+};
+
+/* half of each register field: VT/V0 4 bit, V255 10 bit, the rest 8 bit */
+static const int tp_trim_max[PANEL_NR_TP_TRIM] = {
+	15, 15, 127, 127, 127, 127, 127, 127, 127, 127, 127, 511,
+};
+
+static ssize_t tp_trim_show_one(struct device *dev, int tp, char *buf)
+{
+	struct panel_device *panel = dev_get_drvdata(dev);
+	struct panel_info *panel_data;
+
+	if (panel == NULL)
+		return -EINVAL;
+	panel_data = &panel->panel_data;
+
+	return snprintf(buf, PAGE_SIZE, "%d %d %d\n",
+			panel_data->props.tp_rgb_trim[tp][0],
+			panel_data->props.tp_rgb_trim[tp][1],
+			panel_data->props.tp_rgb_trim[tp][2]);
+}
+
+static ssize_t tp_trim_store_one(struct device *dev, int tp,
+		const char *buf, size_t size)
+{
+	struct panel_device *panel = dev_get_drvdata(dev);
+	struct panel_info *panel_data;
+	int val[3], i;
+
+	if (panel == NULL)
+		return -EINVAL;
+	panel_data = &panel->panel_data;
+
+	if (sscanf(buf, "%d %d %d", &val[0], &val[1], &val[2]) != 3)
+		return -EINVAL;
+
+	for (i = 0; i < 3; i++)
+		if (val[i] < -tp_trim_max[tp] || val[i] > tp_trim_max[tp])
+			return -ERANGE;
+
+	mutex_lock(&panel->op_lock);
+	for (i = 0; i < 3; i++)
+		panel_data->props.tp_rgb_trim[tp][i] = val[i];
+	mutex_unlock(&panel->op_lock);
+	panel_update_brightness(panel);
+
+	dev_info(dev, "%s: tp_%s trim R %d G %d B %d\n",
+			__func__, tp_trim_name[tp], val[0], val[1], val[2]);
+
+	return size;
+}
+
+#define TP_TRIM_ATTR_FUNCS(_idx, _nm)					\
+static ssize_t tp_##_nm##_show(struct device *dev,			\
+		struct device_attribute *attr, char *buf)		\
+{									\
+	return tp_trim_show_one(dev, _idx, buf);			\
+}									\
+static ssize_t tp_##_nm##_store(struct device *dev,			\
+		struct device_attribute *attr,				\
+		const char *buf, size_t size)				\
+{									\
+	return tp_trim_store_one(dev, _idx, buf, size);			\
+}
+
+TP_TRIM_ATTR_FUNCS(0, vt)
+TP_TRIM_ATTR_FUNCS(1, v0)
+TP_TRIM_ATTR_FUNCS(2, v1)
+TP_TRIM_ATTR_FUNCS(3, v7)
+TP_TRIM_ATTR_FUNCS(4, v11)
+TP_TRIM_ATTR_FUNCS(5, v23)
+TP_TRIM_ATTR_FUNCS(6, v35)
+TP_TRIM_ATTR_FUNCS(7, v51)
+TP_TRIM_ATTR_FUNCS(8, v87)
+TP_TRIM_ATTR_FUNCS(9, v151)
+TP_TRIM_ATTR_FUNCS(10, v203)
+TP_TRIM_ATTR_FUNCS(11, v255)
+
+static ssize_t tp_table_show(struct device *dev,
+		struct device_attribute *attr, char *buf)
+{
+	struct panel_device *panel = dev_get_drvdata(dev);
+	struct panel_info *panel_data;
+	int i, len;
+
+	if (panel == NULL)
+		return -EINVAL;
+	panel_data = &panel->panel_data;
+
+	len = snprintf(buf, PAGE_SIZE, "tp       R     G     B\n");
+	for (i = 0; i < PANEL_NR_TP_TRIM; i++)
+		len += snprintf(buf + len, PAGE_SIZE - len,
+				"%-4s %5d %5d %5d\n", tp_trim_name[i],
+				panel_data->props.tp_rgb_trim[i][0],
+				panel_data->props.tp_rgb_trim[i][1],
+				panel_data->props.tp_rgb_trim[i][2]);
+
+	return len;
+}
+
+static ssize_t tp_reset_store(struct device *dev,
+		struct device_attribute *attr, const char *buf, size_t size)
+{
+	struct panel_device *panel = dev_get_drvdata(dev);
+	struct panel_info *panel_data;
+	int value, rc;
+
+	if (panel == NULL)
+		return -EINVAL;
+	panel_data = &panel->panel_data;
+
+	rc = kstrtoint(buf, 0, &value);
+	if (rc < 0)
+		return rc;
+	if (!value)
+		return size;
+
+	mutex_lock(&panel->op_lock);
+	memset(panel_data->props.tp_rgb_trim, 0,
+			sizeof(panel_data->props.tp_rgb_trim));
+	mutex_unlock(&panel->op_lock);
+	panel_update_brightness(panel);
+
+	dev_info(dev, "%s: all tp trims cleared\n", __func__);
+
+	return size;
+}
